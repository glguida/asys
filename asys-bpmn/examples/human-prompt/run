#!/bin/sh
set -eu
demo_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "$demo_directory/../../../tools/asys-run" "$demo_directory/env/human" "$demo_directory/workflow.bpmn" \
  --system human-prompt-demo --dcomp-state-root "$demo_directory/.asys/dcomp" \
  --root "$demo_directory/.asys" "$@"
