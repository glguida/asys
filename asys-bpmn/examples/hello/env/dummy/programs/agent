#!/usr/bin/env python3
"""An ordinary program sharing the named agent's request contract."""
import json
import os
import sys

request = json.load(sys.stdin)
if not isinstance(request, dict) or not isinstance(request.get("request"), str) or not request["request"].strip():
    sys.exit("dummy agent requires a request")
text = request["request"]
result = {"final": text, "exception": None}
with open(os.environ["ASYS_RESULT"], "w") as stream:
    json.dump(result, stream)
