<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:asys="urn:asys:workflow:1" id="AgentReview" targetNamespace="urn:asys:examples" expressionLanguage="feel">
  <bpmn:process id="review" name="Agent and human review" isExecutable="true">
    <bpmn:startEvent id="start"/>
    <bpmn:adHocSubProcess id="work" name="Prepare and review" ordering="Sequential">
      <bpmn:extensionElements>
        <asys:job type="agent" input='= {prompt: "Select draft, wait for its result, then select approval and wait for the human decision. Use list_actions, start_action and wait_action. Summarize the decision when finished."}'/>
      </bpmn:extensionElements>
      <bpmn:serviceTask id="draft" name="Prepare a draft">
        <bpmn:documentation>Prepare the requested draft using the programs available in the workspace.</bpmn:documentation>
        <bpmn:extensionElements>
          <asys:job type="agent" input='= {prompt: "Prepare the requested draft for human review. Include review_summary and review_files in your final JSON using the Reporting to humans guide. Request: " + request}'/>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:userTask id="approval" name="Review the draft">
        <bpmn:extensionElements>
          <asys:job type="human" input='= {
            title: "Review the completed draft",
            prompt: "Accept the draft described below, or request changes in the comments. This example records your decision and ends; requested revisions need a new run.",
            summary: draft.review_summary,
            files: draft.review_files,
            form: {type: "object", properties: {
              approved: {type: "boolean", title: "Accept this draft?",
                oneOf: [{const: true, title: "Accept draft"}, {const: false, title: "Request changes"}]},
              comments: {type: "string", title: "What should change?"}
            }, required: ["approved"], additionalProperties: false}
          }'/>
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="ready_for_review" sourceRef="draft" targetRef="approval"/>
    </bpmn:adHocSubProcess>
    <bpmn:endEvent id="end"/>
    <bpmn:sequenceFlow id="begin" sourceRef="start" targetRef="work"/>
    <bpmn:sequenceFlow id="finish" sourceRef="work" targetRef="end"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="AgentReviewDiagram">
    <bpmndi:BPMNPlane id="AgentReviewPlane" bpmnElement="review">
      <bpmndi:BPMNShape id="StartShape" bpmnElement="start">
        <dc:Bounds x="180" y="162" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WorkShape" bpmnElement="work" isExpanded="true">
        <dc:Bounds x="280" y="80" width="480" height="200"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DraftShape" bpmnElement="draft">
        <dc:Bounds x="330" y="140" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ApprovalShape" bpmnElement="approval">
        <dc:Bounds x="550" y="140" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndShape" bpmnElement="end">
        <dc:Bounds x="820" y="162" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ReviewEdge" bpmnElement="ready_for_review">
        <di:waypoint x="480" y="180"/>
        <di:waypoint x="550" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BeginEdge" bpmnElement="begin">
        <di:waypoint x="216" y="180"/>
        <di:waypoint x="280" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="FinishEdge" bpmnElement="finish">
        <di:waypoint x="760" y="180"/>
        <di:waypoint x="820" y="180"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
