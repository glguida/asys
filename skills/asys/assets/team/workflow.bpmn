<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:asys="urn:asys:workflow:1" id="ReportTeam" name="Report team"
  targetNamespace="urn:asys:skill:team" expressionLanguage="feel">
  <bpmn:process id="report_team" isExecutable="true">
    <bpmn:startEvent id="start"/>
    <bpmn:serviceTask id="implement" name="Write or revise the report">
      <bpmn:extensionElements>
        <asys:job type="implementer" input='= {
          prompt: "Write deliverables/report.md for this request: " + request + " Previous review: " + (if review = null then "First pass; no earlier review." else review.reason),
          feedback: if review = null then "" else review.reason
        }'/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="check" name="Check the report artifact" scriptFormat="python">
      <bpmn:extensionElements>
        <asys:job type="program" args='= ["python3", "-c", task.script]' input="= {}"/>
      </bpmn:extensionElements>
      <bpmn:script><![CDATA[
import json, os
from pathlib import Path
report = Path("deliverables/report.md")
text = report.read_text(encoding="utf-8")
if len(text.strip()) < 50:
    raise SystemExit("Report must contain substantive text, not an empty artifact")
Path(os.environ["ASYS_RESULT"]).write_text(json.dumps({
    "path": str(report), "bytes": report.stat().st_size
}), encoding="utf-8")
]]></bpmn:script>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="review" name="Review evidence and requirements">
      <bpmn:extensionElements>
        <asys:job type="reviewer" input='= {
          prompt: "Inspect deliverables/report.md and its sources against this request: " + request + " Return approved as a boolean and reason as concrete findings, alongside final and exception."
        }'/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="decision" name="Report meets request?" default="revise"/>
    <bpmn:endEvent id="end" name="Report accepted"/>
    <bpmn:sequenceFlow id="begin" sourceRef="start" targetRef="implement"/>
    <bpmn:sequenceFlow id="check_report" sourceRef="implement" targetRef="check"/>
    <bpmn:sequenceFlow id="review_report" sourceRef="check" targetRef="review"/>
    <bpmn:sequenceFlow id="choose" sourceRef="review" targetRef="decision"/>
    <bpmn:sequenceFlow id="accept" name="Accepted" sourceRef="decision" targetRef="end">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">review.approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="revise" name="Revise" sourceRef="decision" targetRef="implement"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="ReportDiagram">
    <bpmndi:BPMNPlane id="ReportPlane" bpmnElement="report_team">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="262" y="30" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="implement_di" bpmnElement="implement"><dc:Bounds x="210" y="110" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="check_di" bpmnElement="check"><dc:Bounds x="210" y="240" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="review_di" bpmnElement="review"><dc:Bounds x="210" y="370" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decision_di" bpmnElement="decision"><dc:Bounds x="255" y="500" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="262" y="620" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="begin_di" bpmnElement="begin"><di:waypoint x="280" y="66"/><di:waypoint x="280" y="110"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="check_report_di" bpmnElement="check_report"><di:waypoint x="280" y="190"/><di:waypoint x="280" y="240"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="review_report_di" bpmnElement="review_report"><di:waypoint x="280" y="320"/><di:waypoint x="280" y="370"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="choose_di" bpmnElement="choose"><di:waypoint x="280" y="450"/><di:waypoint x="280" y="500"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="accept_di" bpmnElement="accept"><di:waypoint x="280" y="550"/><di:waypoint x="280" y="620"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="revise_di" bpmnElement="revise"><di:waypoint x="255" y="525"/><di:waypoint x="100" y="525"/><di:waypoint x="100" y="150"/><di:waypoint x="210" y="150"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
