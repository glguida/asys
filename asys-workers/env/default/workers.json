{
  "version": 1,
  "name": "default",
  "description": "Pi agents, ordinary programs, and human requests.",
  "types": {
    "agent": {
      "command": [
        "/opt/asys/asys-workers/tools/asys-worker",
        "--definition",
        "/opt/asys/environment/workers/agent.json"
      ]
    },
    "goal": {
      "command": [
        "/opt/asys/asys-workers/tools/asys-worker",
        "--definition",
        "/opt/asys/environment/workers/goal.json"
      ]
    },
    "senate": {
      "command": [
        "/opt/asys/asys-workers/tools/asys-worker",
        "--definition",
        "/opt/asys/environment/workers/senate.json"
      ]
    },
    "program": {
      "command": [
        "/opt/asys/asys-workers/tools/asys-program"
      ]
    },
    "human": {
      "command": [
        "/opt/asys/asys-workers/tools/asys-human"
      ]
    }
  }
}
