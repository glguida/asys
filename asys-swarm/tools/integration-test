#!/usr/bin/env python3
"""Exercise one swarm worker job with component and host worlds, without models."""
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import tempfile
import time
from urllib.request import Request, urlopen

ROOT = Path(__file__).resolve().parents[1]
REPOSITORY = ROOT.parent
CLI = ROOT / 'tools/asys-swarm'
DEMO = ROOT / 'examples/terrarium'
sys.path[:0] = [str(REPOSITORY / 'asys-workers'), str(REPOSITORY / 'asys-runtime')]
from asys_swarm.replay import replay


def main():
    with tempfile.TemporaryDirectory(prefix='asys-sw-') as temporary:
        root = Path(temporary)
        system = 'swarm-test-' + root.name.removeprefix('asys-sw-').replace('_', '-')
        dcomp = [os.environ.get('DCOMP_BINARY', 'dcomp'), '--state-root', str(root / 'dcomp'),
                 '--runtime-root', str(root / 'proxy')]
        commands = root / 'commands.log'
        system_file = root / 'system.dcomp'
        system_file.write_text(f'system {system}\n')
        workspace = root / 'workspace'
        workspace.mkdir()
        config = json.loads((DEMO / 'swarm.json').read_text())
        config['limits']['tickSeconds'] = 0.1
        (root / 'swarm.json').write_text(json.dumps(config))
        (root / 'view.html').write_text((DEMO / 'view.html').read_text())
        process = None
        replay_process = None
        stderr = root / 'setup.log'

        def run(command, timeout=180):
            result = subprocess.run(list(map(str, command)), capture_output=True, text=True, timeout=timeout)
            with commands.open('a') as output:
                output.write(f'{command!r}\n{result.stdout}\n{result.stderr}\n')
            if result.returncode:
                raise AssertionError(f'{command!r}: {result.stdout[-2000:]}\n{result.stderr[-6000:]}')
            return result.stdout

        def until(function, timeout=120):
            deadline = time.monotonic() + timeout
            while time.monotonic() < deadline:
                value = function()
                if value:
                    return value
                if process is not None and process.poll() is not None:
                    raise AssertionError(f'Launcher exited early ({process.returncode}):\n{stderr.read_text()}')
                time.sleep(0.1)
            raise AssertionError(f'Timed out:\n{stderr.read_text()}')

        def http(url, path, body=None):
            request = Request(url.rstrip('/') + path,
                data=json.dumps(body).encode() if body is not None else None,
                headers={'Content-Type': 'application/json', 'Origin': url.rstrip('/')})
            with urlopen(request, timeout=5) as response:
                return json.load(response)

        try:
            run(dcomp + ['up', system_file])
            for mode, cancel in [('component', False), ('host', False), ('host', True)]:
                label = mode + ('-cancel' if cancel else '-complete')
                stderr, stdout = root / f'{label}.log', root / f'{label}.json'
                world_args = ['--world', str(DEMO / 'world')] if mode == 'component' else [
                    '--world-command', json.dumps([sys.executable, str(DEMO / 'world/serve.py')])]
                with stdout.open('w') as output, stderr.open('w') as errors:
                    process = subprocess.Popen([str(CLI), 'run', str(root / 'swarm.json'),
                        str(DEMO / 'env/scripted'), *world_args, '--root', str(root),
                        '--workspace', str(workspace), '--system', system,
                        '--dcomp-state-root', str(root / 'dcomp'), '--runtime-root', str(root / 'proxy'),
                        '--view'], stdout=output, stderr=errors)
                match = until(lambda: re.search(r'Viewer: (http://127\.0\.0\.1:\d+/)', stderr.read_text()))
                url = match.group(1)
                with urlopen(url, timeout=5) as response:
                    assert b'Rainkeepers' in response.read()
                record = http(url, '/api/run')
                directory = root / 'runs' / record['id']
                until(lambda: http(url, '/api/state').get('turn', 0) >= 1)
                assert set(record['components']) == ({'world', 'workers'} if mode == 'component' else {'workers'}), record
                assert not (directory / 'package').exists(), 'Scenario code must not be copied into the run'
                view = json.loads(run(dcomp + ['view', '--json', system]))
                components = {item['name']: item for item in view['components']}
                for name in record['components'].values():
                    assert components[name]['status']['status'] == 'running'
                    assert not components[name]['status'].get('published_ports')
                workers = components[record['components']['workers']]
                worker = json.loads(run(['docker', 'inspect', workers['status']['container_id']]))[0]
                mounts = {m['Destination'] for m in worker['Mounts']}
                assert '/opt/asys/swarm-package' not in mounts and '/var/lib/asys-swarm' not in mounts
                if mode == 'component':
                    world = components[record['components']['world']]
                    container = json.loads(run(['docker', 'inspect', world['status']['container_id']]))[0]
                    world_mounts = {m['Destination'] for m in container['Mounts']}
                    assert '/var/lib/asys/runtime/channels/world' in world_mounts
                    assert not {'/var/lib/asys/jobs', '/var/lib/asys/workspace', '/var/lib/asys/runtime'} & world_mounts
                jobs = list((directory / 'runtime/environments').glob('*/jobs/*/request.json'))
                assert len(jobs) == 1, jobs
                assert json.loads(jobs[0].read_text())['type'] == 'swarm'
                http(url, '/api/control', {'type': 'pause'})
                until(lambda: http(url, '/api/state').get('status') == 'paused')
                assert http(url, '/api/events?after=0')['events']
                run([CLI, 'resume', directory])
                if cancel:
                    run([CLI, 'cancel', directory])
                    assert process.wait(timeout=45) == 130
                    record = json.loads((directory / 'run.json').read_text())
                    assert record['status'] == 'cancelled' and record['components_removed'], record
                    print('PASS: host world pause/resume/cancel; parent job and services cleaned', flush=True)
                else:
                    record = until(lambda: (r if (r := json.loads((directory / 'run.json').read_text())).get('components_removed') else None))
                    assert record['status'] == 'completed', record
                    assert process.poll() is None, 'Viewer should remain available after completion'
                    result = json.loads(stdout.read_text())
                    assert result['achieved'] is True, result
                    assert result['turns'] == 36 and result['decisions'] == 192, result
                    assert result['usage']['totalTokens'] == 0, result
                    for artifact in result['files'].values():
                        assert (workspace / artifact).is_file(), artifact
                    parent = directory / record['job_directory']
                    assert len(list((parent / 'swarm/decisions').glob('*/state.json'))) == 192
                    runtime_state = json.loads(jobs[0].with_name('state.json').read_text())
                    assert runtime_state['status'] == 'done', runtime_state
                    assert runtime_state['result']['exception'] is None
                    assert http(url, '/api/state')['status'] == 'completed'
                    # Replay uses the same protocol against a fresh service,
                    # without importing world source into the replay client.
                    replay_root = root / f'{label}-replay'
                    with (root / 'replay.log').open('ab') as log:
                        replay_process = subprocess.Popen([sys.executable, str(DEMO / 'world/serve.py'),
                            '--root', str(replay_root)], stdout=log, stderr=log)
                        checked = replay(replay_root, json.loads((directory / 'config.json').read_text()),
                                         parent / 'swarm/events.jsonl')
                        assert checked['verified'] and checked['terminal'] and checked['turns'] == 36, checked
                        replay_process.terminate()
                        replay_process.wait(timeout=5)
                        replay_process = None
                    process.send_signal(signal.SIGINT)
                    assert process.wait(timeout=10) == 0
                    assert json.loads((directory / 'run.json').read_text())['status'] == 'completed'
                    print(f'PASS: {mode} world; one runtime job, 192 member decisions, 36 turns, goal and protocol replay verified', flush=True)
                process = None
                assert not json.loads(run(dcomp + ['view', '--json', system]))['components']
            return 0
        except BaseException:
            saved = ROOT / 'integration-failure.log'
            with saved.open('w') as output:
                for path in [commands, *root.glob('*.log'), *root.glob('runs/*/components.log'),
                             *root.glob('runs/*/world.log'), *root.glob('runs/*/jobs/*/stderr.log')]:
                    if path.exists():
                        output.write(f'\n{path.name}\n{path.read_text()}')
            print(f'Failure logs: {saved}', file=sys.stderr)
            raise
        finally:
            if replay_process is not None and replay_process.poll() is None:
                replay_process.terminate()
                replay_process.wait(timeout=5)
            if process is not None and process.poll() is None:
                process.send_signal(signal.SIGINT)
                try:
                    process.wait(timeout=45)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait(timeout=10)
            subprocess.run(dcomp + ['down', system], capture_output=True, timeout=60)


if __name__ == '__main__':
    raise SystemExit(main())
