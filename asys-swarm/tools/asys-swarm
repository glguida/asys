#!/usr/bin/env python3
"""Submit a swarm worker job through the asys runtime."""
from pathlib import Path
import sys

executable = Path(__file__).resolve()
for root in (executable.parents[1] / 'share/asys/python',
             executable.parents[1] / 'share/asys-swarm/python',
             executable.parents[2] / 'python', executable.parents[2] / 'asys-runtime',
             executable.parents[2] / 'asys-workers'):
    if root.is_dir():
        sys.path.insert(0, str(root))
from asys.swarm import main

if __name__ == '__main__':
    sys.exit(main())
