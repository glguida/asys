#!/usr/bin/env python3
"""Run the goal worker in a selected environment."""
from pathlib import Path
import sys

executable = Path(__file__).resolve()
for root in (executable.parents[1] / 'share/asys/python', executable.parents[2] / 'python',
             executable.parents[2] / 'asys-runtime'):
    if root.is_dir():
        sys.path.insert(0, str(root))
from asys.goal import main

if __name__ == '__main__':
    sys.exit(main())
