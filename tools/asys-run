#!/usr/bin/env python3
"""Run a named agent, goal, senate, swarm, or program in an environment."""
from pathlib import Path
import sys

executable = Path(__file__).resolve()
root = executable.parents[1]
for directory in (root / 'asys-runtime', root / 'asys-workers', root / 'share/asys/python', root / 'python'):
    if directory.is_dir():
        sys.path.insert(0, str(directory))
from asys.run import main

if __name__ == '__main__':
    sys.exit(main())
