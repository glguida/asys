#!/usr/bin/env python3
"""Author environment files and import shared skills."""
from pathlib import Path
import sys

root = Path(__file__).resolve().parents[1]
for directory in (root / 'asys-runtime', root / 'asys-workers', root / 'python',
                  root / 'share/asys/python'):
    if directory.is_dir():
        sys.path.insert(0, str(directory))
from asys.environment import main

if __name__ == '__main__':
    sys.exit(main())
