#!/usr/bin/env python3
"""Author worker definitions in an environment."""
from pathlib import Path
import sys

root = Path(__file__).resolve().parents[1]
for directory in (root / 'asys-runtime', root / 'asys-workers', root / 'python',
                  root / 'share/asys/python', root / 'share/asys-swarm/python'):
    if directory.is_dir():
        sys.path.insert(0, str(directory))
from asys.workers import main

if __name__ == '__main__':
    sys.exit(main())
